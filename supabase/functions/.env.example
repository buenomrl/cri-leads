# Segredos das Edge Functions. Copie para supabase/functions/.env (gitignorado)
# APENAS para rodar `supabase functions serve` localmente.
#
# Em producao NADA disto vive em arquivo: sao secrets do projeto, definidos com
#   npx supabase secrets set NOME=valor --profile cri
# e SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY nem precisam ser definidos — o
# runtime das Edge Functions injeta os dois automaticamente.

# Injetados automaticamente em producao; so' necessarios no serve local.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Chave que libera os caminhos de ESCRITA (POST/PATCH) e o agente.
# Nao e' autenticacao: e' uma credencial unica de demonstracao. Ver SECURITY.md.
DEMO_WRITE_KEY=

# Chave da Anthropic. Defina um spend limit no console antes de usar.
ANTHROPIC_API_KEY=

# Origens autorizadas no CORS, separadas por virgula. Higiene, nao controle de
# acesso (curl ignora CORS) — ver SECURITY.md.
ALLOWED_ORIGINS=http://localhost:5173
